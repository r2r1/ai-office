# LLM-провайдер (OpenAI-совместимый, например apinet.cloud)
LLM_BASE_URL=https://apinet.cloud/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=qwen3-vl-plus

# Демо-режим: 1 = проигрывать сценарий без API (бесплатно), 0 = реальные агенты
DEMO_MODE=0

# Интервал рабочего цикла в секундах
LOOP_INTERVAL_SECONDS=300
