# LLM (OpenAI-совместимый провайдер)
LLM_BASE_URL=https://apinet.cloud/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.4              # apinet: gpt-5.4 ~ $2.5/$15 за 1M (вход/выход)
# LLM_PROXY_URL=socks5://user:pass@host:port   # опционально: если сервер на РФ-IP,
                                                # а провайдер оттуда не принимает запросы —
                                                # прокси только для LLM-вызовов, не для
                                                # всего сервера (http:// тоже подходит)

# Режимы
DEMO_MODE=0                   # 1 = демо без расхода токенов
LOOP_INTERVAL_SECONDS=10

# BONUS_BALANCE_USD=5           # бюджетный лимит, который автоматически ставится
                                 # новому тенанту при регистрации (src/saas/store.py) —
                                 # даёт попробовать офис без ручной настройки; 0 = не
                                 # выдавать бонус. До реальной платёжной системы это и
                                 # есть "баланс" (costs.py, тот же лимит, что в Настройки
                                 # → Лимиты) — офис встаёт на паузу, когда бонус кончается.

# ADMIN_API_KEY=...            # опционально: включает /admin/api/* (routers/admin.py) —
                                # обзор по ВСЕМ тенантам (баланс, ошибки, пауза, прокси)
                                # для отдельного изолированного admin_panel/index.html.
                                # Без ключа /admin/api/* отвечает 503 — не задавайте
                                # его на публичном сервере, куда не должен попасть админ-доступ.
                                # Тот же ключ использует scripts/supervisor.py (ниже).
# SUPERVISOR_PORT=8001          # порт scripts/supervisor.py — отдельный, ВСЕГДА
                                # запущенный процесс (не reload!), который умеет
                                # запускать/останавливать основной сервер и удалять
                                # тенантов из admin_panel/index.html — без него
                                # включить остановленный сервер из админки нельзя
                                # (некому ответить на запрос). Запуск: python
                                # scripts/supervisor.py, отдельно от scripts/run.py.

# Распределённое состояние (rate-limit; дальше — локи офис-циклов, SSE pub/sub)
# для запуска НЕСКОЛЬКИХ серверов одновременно (docs/technical-due-diligence-
# 2026-07-17.md §2.1/§11). Не обязателен для локальной разработки/одного
# сервера — без REDIS_URL всё работает как раньше (in-memory, один процесс).
# REDIS_URL=redis://localhost:6379/0

# ⚠️ Исполнение кода/shell-команд из workspace (execute_code, /api/run, /api/terminal)
# По умолчанию ВЫКЛЮЧЕНО. Включай только за реальной песочницей (SANDBOX_MODE=docker
# ниже) или на доверенном одиночном деплое без внешних клиентов.
ALLOW_CODE_EXECUTION=0

# Изоляция исполнения (см. src/office/exec_sandbox.py, docker/sandbox.Dockerfile):
#   direct — (по умолчанию) исполнение НАПРЯМУЮ на хосте, БЕЗ изоляции — процесс
#            может прочитать данные других тенантов, .env и т.п.
#            (docs/audit-dd-2026-07.md §17, docs/audit-dd-2026-07-06.md §11).
#   docker — исполнение в контейнере без сети, read-only ФС, лимитами CPU/памяти.
#            Требует: docker build -f docker/sandbox.Dockerfile -t ai-office-sandbox .
#            и запущенный Docker — если недоступен, execute_code/run_command явно
#            откажут (не тихий fallback на direct).
SANDBOX_MODE=direct
# SANDBOX_IMAGE=ai-office-sandbox
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1
# SANDBOX_PIDS=128

# Шифрование секретов at-rest (Fernet) + подпись сессий. ОБЯЗАТЕЛЕН на проде —
# без него сервер падает при старте (src/saas/crypto.py::require_app_secret).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# 1 = разрешить старт без APP_SECRET (небезопасный dev-ключ, только для локальной
# разработки на своей машине — НЕ для общего/прод-окружения).
DEV_MODE=1

# Ротация APP_SECRET (опционально): при смене секрета положите СТАРОЕ значение
# сюда (через запятую, если старых несколько) — decrypt() продолжит читать
# данные, зашифрованные им, пока не прогоните scripts/rotate_secret.py --apply
# и не уберёте эту переменную. Без неё смена APP_SECRET навсегда ломает доступ
# к уже сохранённым кредам всех тенантов.
# APP_SECRET_PREVIOUS=

# Эмбеддинги для семантического поиска по памяти (src/core/embeddings.py,
# src/office/knowledge.py) — вторичный сигнал ранжирования поверх пересечения
# ключевых слов. Через тот же LLM_BASE_URL/LLM_API_KEY (apinet поддерживает
# /v1/embeddings — проверено вживую). При недоступности провайдера (баланс,
# сеть) retrieve() молча деградирует к прежнему TF-поиску, ничего не падает.
# EMBEDDING_MODEL=text-embedding-3-small

# OAuth-интеграции «Ресурсы → Доступы» (одно приложение на все тенанты, см.
# src/integrations/*_oauth.py — там же точные шаги настройки в каждом приложении):
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# BITRIX24_CLIENT_ID=
# BITRIX24_CLIENT_SECRET=

# apinet: свой API-ключ на каждый профиль (опционально).
# Если заданы — новому workspace выдаётся отдельный apinet-ключ с лимитом квоты
# (изоляция расхода + защита от пережога). Получить: ЛК apinet -> Настройки ->
# Access Token и User ID.
# APINET_ACCESS_TOKEN=
# APINET_USER_ID=
# APINET_BASE=https://apinet.cloud
# APINET_TENANT_QUOTA=500000  # лимит квоты на ключ тенанта (500000 = $1)
