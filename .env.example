# LLM (OpenAI-совместимый провайдер)
LLM_BASE_URL=https://apinet.cloud/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.4              # apinet: gpt-5.4 ~ $2.5/$15 за 1M (вход/выход)

# Режимы
DEMO_MODE=0                   # 1 = демо без расхода токенов
LOOP_INTERVAL_SECONDS=10

# ⚠️ Исполнение кода/shell-команд из workspace (execute_code, /api/run, /api/terminal)
# НЕ изолировано от файловой системы хоста — процесс может прочитать данные других
# тенантов (../../<tid>/connections.json), .env и т.п. (docs/audit-dd-2026-07.md §17).
# По умолчанию ВЫКЛЮЧЕНО. Включай только за реальной песочницей (контейнер) или на
# доверенном одиночном деплое без внешних клиентов.
ALLOW_CODE_EXECUTION=0

# Шифрование секретов at-rest (Fernet) + подпись сессий. ОБЯЗАТЕЛЕН на проде —
# без него сервер падает при старте (src/saas/crypto.py::require_app_secret).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# 1 = разрешить старт без APP_SECRET (небезопасный dev-ключ, только для локальной
# разработки на своей машине — НЕ для общего/прод-окружения).
DEV_MODE=1

# Ротация APP_SECRET (опционально): при смене секрета положите СТАРОЕ значение
# сюда (через запятую, если старых несколько) — decrypt() продолжит читать
# данные, зашифрованные им, пока не прогоните scripts/rotate_secret.py --apply
# и не уберёте эту переменную. Без неё смена APP_SECRET навсегда ломает доступ
# к уже сохранённым кредам всех тенантов.
# APP_SECRET_PREVIOUS=

# apinet: свой API-ключ на каждый профиль (опционально).
# Если заданы — новому workspace выдаётся отдельный apinet-ключ с лимитом квоты
# (изоляция расхода + защита от пережога). Получить: ЛК apinet -> Настройки ->
# Access Token и User ID.
# APINET_ACCESS_TOKEN=
# APINET_USER_ID=
# APINET_BASE=https://apinet.cloud
# APINET_TENANT_QUOTA=500000  # лимит квоты на ключ тенанта (500000 = $1)
